# ==============================================================================
# ENVIRONMENT VARIABLES - PARTNERUP & UNTUNGIN KAS STANDALONE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI ENGINE (GOOGLE GEMINI API) - SERVER SIDE
# ------------------------------------------------------------------------------
# Kunci API Google Gemini untuk analisis AI lembar aksi & rekomendasi UMKM.
# Di AI Studio Build: Otomatis di-inject dari secrets.
# Di Vercel / Cloud Run: Wajib diisi di Project Settings > Environment Variables
GEMINI_API_KEY=""

# URL host aplikasi (otomatis di-set di runtime jika tidak diisi)
APP_URL="https://partnerup.app"

# ------------------------------------------------------------------------------
# 2. GOOGLE APPS SCRIPT (GAS) ENDPOINTS
# ------------------------------------------------------------------------------
# Endpoint Google Apps Script Utama PartnerUp (Sinkronisasi Peserta, Absensi, Asesmen, Tugas)
VITE_GAS_ENDPOINT_URL="https://script.google.com/macros/s/AKfycbwpLuT1HtWX7I9l1ABa2YthchqYEZ4cEuLcmXjeyW_PHOgXw9D9GhoOROySnKFHr1vO/exec"

# Endpoint Google Apps Script Shadow Vault / Untungin Standalone (Khusus Kas Keuangan UMKM)
# Digunakan oleh Untungin Kas Standalone (untungin-kas.vercel.app) & Dual-Stream Sync
VITE_UNTUNGIN_VAULT_ENDPOINT="https://script.google.com/macros/s/AKfycbzt3TEU-OQioP9OxUm5BPHuuAihKqF1tJDDb396T4TguB2V_-KpKMaLD5O8VD6xAiVk/exec"

# ------------------------------------------------------------------------------
# 3. WHATSAPP GATEWAY (FONNTE API) - OPSIONAL
# ------------------------------------------------------------------------------
# Token API Fonnte untuk notifikasi pendaftaran, absensi, reminder & laporan kas
VITE_FONNTE_TOKEN=""

# ID Grup WhatsApp Peserta (format: 120363xxx@g.us)
VITE_FONNTE_PESERTA_GROUP_ID=""

# ID Grup WhatsApp Panitia / Fasilitator (format: 120363xxx@g.us)
VITE_FONNTE_PANITIA_GROUP_ID=""

